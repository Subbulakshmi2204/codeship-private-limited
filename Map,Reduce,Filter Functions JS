console.log("Multiply each number by 2");
let numbers = [6,7,8,9,10];

let result = numbers.map(function(num)
{
  return num*2;
});

console.log(result);
console.log();

console.log("Find even numbers");
let number = [1,3,4,5,7,8];
let evenno = number.filter(function(num)
{
  return num % 2 === 0;
});

console.log(evenno);
console.log();

console.log("Find sum of array");
let sum = numbers.reduce(function(total,num)
{
  return total+num;
},0);
console.log(sum);
console.log();

console.log("Converting Name to UpperCase");
let names =["subbu","rickshitha","dharshini","kiruthiga"];
let uppernames = names.map(name => name.toUpperCase());
console.log(uppernames);
