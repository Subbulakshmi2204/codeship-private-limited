console.log("Filter number greater than 10");
let no = [5,12,8,20,3,14];
let res = no.filter(num => num > 10);
console.log(res);
console.log();

console.log("Filter words with length greater than 4");
let words = ['apple','cat','banana','dog','lion'];
let longword = words.filter(word => word.length>4);
console.log(longword);
console.log();

console.log("Product of numbers");
let product = numbers.reduce((total,num) => total*num,1);
console.log(product);

console.log("Maximum number");
let n = [07,45,2,33,18];
let max = n.reduce((largest,num) => 
{
  return num > largest ?  num : largest;
});
console.log(max);
console.log();

console.log("Filter positive numbers");
let nos = [-2,5,-1,9,0];
let positive = nos.filter(num => num>0);
console.log(positive);
console.log();

console.log("count total characters in words");
let word = ['hi','hello','welcome'];
let count = word.reduce((total,word) => total+word.length,0);
console.log(count);
console.log();

console.log("Total marks");
let marks = [80,75,90,60];
let total = marks.reduce((sum,mark) => sum+mark,0);
console.log(total);
