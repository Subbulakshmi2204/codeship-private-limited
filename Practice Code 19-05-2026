const isPalindrome = (str) => {
  let reversed = str.split("").reverse().join("");

  if (str == reversed) 
  {
    return "String is a Palindrome";
  } 
  else 
  {
    return "String is not a Palindrome";
  }
};

console.log(isPalindrome("madam"));
console.log(isPalindrome("hello"));

