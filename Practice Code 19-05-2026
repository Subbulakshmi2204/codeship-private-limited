console.log("Simple Calculator");
function calc(a,b,op)
{
  if(op === "+")
  return a+b;
  if(op === "-")
  return a-b;
  if(op === "*")
  return a*b;
  if(op === "/")
  return a/b;
  
  return "Invalid Operator";
}
console.log(calc(3,5,"+"));
console.log(calc(4,5,"**"));
