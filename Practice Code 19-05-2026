function isPrime(n)
{
  if(n <= 1)
  return "Not Prime";
    for(let i=2;i<n;i++)
    {
      if(n%i==0)
      return "Not Prime";
    }
  return "Prime";
}
console.log(isPrime(7));
console.log(isPrime(10));

function fibanocci(n)
{
  let a =0;
  let b = 1;
  console.log("Fibanocci Series");
  for(let i=1;i<=n;i++)
  {
    console.log(a);
    let next = a+b;
    a=b;
    b=next;
  }
}
