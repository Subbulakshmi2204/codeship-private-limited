console.log("Counting Vowels");
function vowels(tr)
{
  let v ="aeiouAEIOU";
  let count = 0;
  for(let ch of tr)
  {
    if(v.includes(ch))
    {
      count++;
    }
  }
  return count;
}
console.log("Vowels: "+vowels("Python"));

function findmax(arr)
{
  let max = arr[0];
  for(let i=1;i<arr.length;i++)
  {
    if(arr[i] > max)
    {
      max = arr[i];
    }
  }
  return max;
}
console.log("Maximum value in array: "+findmax([90,100,50,11,540]));

function arrsum(arr)
{
  let s = 0;
  for(let i=0;i<arr.length;i++)
  {
    s+=arr[i];
  }
  return s;
}
console.log("Sum of values in array: "+arrsum([2,3,4,5,66]));

function wordcount(t)
{
  return t.trim().split(" ").length;
}
console.log("Word count in a string: "+wordcount("Hello World!"));

function swap(a,b)
{
  console.log("Before swap: "+a,b);
  let temp = a;
  a = b;
  b = temp;
  console.log("After swap: "+a,b);
}
swap(2,3);

